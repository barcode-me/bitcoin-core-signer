<div class="qr-viewer" tabindex="0" hidden aria-label="Encrypted QR codes to scan on the {{device}} device">
  <div class="sb58-header">
    <p class="sb58-progress qr-progress" aria-live="polite"></p>
    <button type="button" data-action="qr-previous">Previous</button>
    <button type="button" data-action="qr-play">Pause</button>
    <button type="button" data-action="qr-next">Next</button>
  </div>
  <img class="qr-image" alt="" hidden>
  <p class="qr-status" role="status"></p>
  <p class="sb58-help">The QR codes change every second. Press Scan QR codes on the {{device}} device and hold its camera to this screen until it has read every code, in any order. Click here, then press <kbd>&larr;</kbd> and <kbd>&rarr;</kbd> to step through them, or <kbd>Space</kbd> to pause.</p>
</div>
