<form id="{{id}}" class="phonetic-form transfer-mode" autocomplete="off" novalidate>
  <fieldset class="field-group">
    <legend>Transfer with</legend>
    <label class="choice"><input type="radio" name="{{id}}-mode" value="sb58" checked> Super Base 58 lines, typed by hand</label>
    <label class="choice"><input type="radio" name="{{id}}-mode" value="qr"> Encrypted QR codes, scanned with the camera</label>
  </fieldset>
</form>
