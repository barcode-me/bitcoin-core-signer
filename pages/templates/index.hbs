{{#> layout pageTitle="Contents" description="A reference guide to signing transactions with bitcoin core and using BIP 39 backups."}}
<p class="eyebrow">THE GUIDE</p>
<h1>Bitcoin Core BIP39 Signer</h1>
<p class="lead">How-to guide for restoring a BIP39 wallet securely and privately.</p>
<section class="contents">
  <h2 id="contents-heading">Table of contents</h2>
  <ol>
  {{#each sections}}
  <li><a class="section-link" href="{{href}}">
    <span><strong>{{title}}</strong><span class="section-description">{{description}}</span></span>
    <span class="arrow">→</span>
  </a>
    {{#if steps}}
    <ul class="contents-steps">
      {{#each steps}}
      <li><a href="{{href}}">{{number}}. {{title}}</a></li>
      {{/each}}
    </ul>
    {{/if}}
  </li>
  {{/each}}
</ol>
</section>
{{/layout}}
